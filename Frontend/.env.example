# For localhost development (default):
VITE_API_BASE_URL=http://localhost:5271

# For local network access, replace with your machine's LAN IP:
# VITE_API_BASE_URL=http://192.168.1.XXX:5271
#
# To find your IP:
#   Windows: ipconfig  (look for IPv4 Address under your Wi-Fi/Ethernet adapter)
#   Linux/Mac: ip addr or ifconfig
#
# Copy this file to .env.local and set your IP — Vite loads .env.local with highest priority.
